.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/

# Secrets never belong in the repository.
.env
.env.*
!.env.example

# Run outputs; commit curated examples explicitly.
results/*
!results/examples/
# External pilot: manifests, estimates and summaries are committed; raw records and diagnostics
# (which contain benchmark content) stay local.
!results/external_pilot/
results/external_pilot/**/records.jsonl
results/external_pilot/**/diagnostics*.jsonl
# Adversarial study: manifests, cost reports, the attack audit and summaries are committed; raw
# records stay local.
!results/adversarial_study/
results/adversarial_study/**/records.jsonl

# External benchmark files fetched from their pinned upstream sources (never redistributed here).
data/external/
